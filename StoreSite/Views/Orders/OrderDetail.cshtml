@model StoreSite.Models.Order
@{
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    ViewBag.Title = "Đơn hàng #" + Model.OrderID;
    var details = Model.OrderDetails.OrderBy(d => d.ID).ToList();
    int tongSL = details.Sum(d => d.Quantity);
    bool xong = Model.PaymentStatus == "Complete";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/CartPage.css")?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="@Url.Content("~/Content/PaymentPage.css")?v=@DateTime.Now.Ticks" />
}

<div class="cart-page">
    <nav class="cart-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a> /
        <span>Đơn hàng #@Model.OrderID</span>
    </nav>

    @if (TempData["ThongBao"] != null)
    {
        <div class="pay-alert pay-alert--success" role="status">@TempData["ThongBao"]</div>
    }

    <h1 class="cart-title">
        Đơn hàng #@Model.OrderID
        <span class="order-status @(xong ? "is-done" : "")">@(xong ? "Hoàn tất" : "Chờ xử lý")</span>
    </h1>
    <p class="order-date">Đặt lúc @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>

    <div class="cart-layout">
        <div>
            <section class="pay-box">
                <h2 class="pay-box-title">Thông tin giao hàng</h2>
                <div class="pay-info-row"><span>Người nhận</span><b>@Model.ReceiverName</b></div>
                <div class="pay-info-row"><span>Số điện thoại</span><b>@Model.ReceiverPhone</b></div>
                <div class="pay-info-row"><span>Địa chỉ</span><b>@Model.AddressDelivery</b></div>
                <div class="pay-info-row"><span>Ghi chú</span><b>@(string.IsNullOrEmpty(Model.Note) ? "Không có" : Model.Note)</b></div>
                <div class="pay-info-row"><span>Thanh toán</span><b>@(Model.PaymentMethod == "bank" ? "Chuyển khoản ngân hàng" : "Thanh toán khi nhận hàng (COD)")</b></div>
            </section>

            <section class="pay-box">
                <h2 class="pay-box-title">Sản phẩm (@tongSL đôi)</h2>
                @foreach (var d in details)
                {
                    <div class="pay-line">
                        <img src="@Url.Content("~" + d.SanPham.ImgURL)" alt="@d.SanPham.ItemName" />
                        <div>
                            <div class="cart-name">@d.SanPham.ItemName</div>
                            <div class="cart-meta">Size: @d.SneakerSize &times; @d.Quantity</div>
                        </div>
                        <div class="cart-line-total">@((d.UnitPrice * d.Quantity).ToString("N0")) đ</div>
                    </div>
                }
            </section>
        </div>

        <aside class="cart-summary">
            <h2 class="cart-summary-title">Tóm tắt đơn hàng</h2>
            <div class="cart-sum-row"><span>Số lượng</span><span><b>@tongSL</b> đôi</span></div>
            <div class="cart-sum-row cart-sum-total"><span>Tổng cộng</span><span>@Model.TotalAmount.ToString("N0") đ</span></div>
            <a href="@Url.Action("Index", "Store")" class="cart-btn cart-checkout">Tiếp tục mua sắm</a>
            <a href="@Url.Action("UserPage", "User", new { tab = "orders" })" class="cart-continue">← Xem tất cả đơn hàng</a>
        </aside>
    </div>
</div>