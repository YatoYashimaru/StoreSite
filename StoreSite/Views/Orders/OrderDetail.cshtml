@model StoreSite.Models.Order
@{
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    ViewBag.Title = "Đơn hàng #" + Model.Id;
    var items = Model.TakeItems();
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/CartPage.css")?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="@Url.Content("~/Content/PaymentPage.css")?v=@DateTime.Now.Ticks" />
}

<div class="cart-page">
    <nav class="cart-breadcrumb">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a> /
        <span>Đơn hàng #@Model.Id</span>
    </nav>

    @if (TempData["ThongBao"] != null)
    {
        <div class="pay-alert pay-alert--success" role="status">@TempData["ThongBao"]</div>
    }

    <h1 class="cart-title">Đơn hàng #@Model.Id <span class="order-status">@Model.Status</span></h1>
    <p class="order-date">Đặt lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

    <div class="cart-layout">

        <div>
            <!-- Thông tin giao hàng -->
            <section class="pay-box">
                <h2 class="pay-box-title">Thông tin giao hàng</h2>
                <div class="pay-info-row"><span>Người nhận</span><b>@Model.ReceiverName</b></div>
                <div class="pay-info-row"><span>Số điện thoại</span><b>@Model.Phone</b></div>
                <div class="pay-info-row"><span>Địa chỉ</span><b>@Model.Address</b></div>
                <div class="pay-info-row"><span>Ghi chú</span><b>@(string.IsNullOrEmpty(Model.Note) ? "Không có" : Model.Note)</b></div>
                <div class="pay-info-row"><span>Thanh toán</span><b>@Model.PaymentMethodText()</b></div>
            </section>

            <!-- Sản phẩm trong đơn -->
            <section class="pay-box">
                <h2 class="pay-box-title">Sản phẩm (@Model.SumQuantity() đôi)</h2>
                @foreach (var item in items)
                {
                    <div class="pay-line">
                        <img src="@Url.Content("~" + item.ImgURL)" alt="@item.ProductName" />
                        <div>
                            <div class="cart-name">@item.ProductName</div>
                            <div class="cart-meta">Size: @item.Size &times; @item.Quantity</div>
                        </div>
                        <div class="cart-line-total">@item.LineTotal().ToString("N0") đ</div>
                    </div>
                }
            </section>
        </div>

        <!-- Tóm tắt -->
        <aside class="cart-summary">
            <h2 class="cart-summary-title">Tóm tắt đơn hàng</h2>
            <div class="cart-sum-row">
                <span>Số lượng</span>
                <span><b>@Model.SumQuantity()</b> đôi</span>
            </div>
            <div class="cart-sum-row cart-sum-total">
                <span>Tổng cộng</span>
                <span>@Model.TotalPrice().ToString("N0") đ</span>
            </div>
            <a href="@Url.Action("Index", "Store")" class="cart-btn cart-checkout">Tiếp tục mua sắm</a>
            <a href="@Url.Action("UserPage", "User", new { tab = "orders" })" class="cart-continue">← Xem tất cả đơn hàng</a>
        </aside>

    </div>
</div>
