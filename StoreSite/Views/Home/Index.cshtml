@{
    ViewBag.Title = "Home Page";
}

@model StoreSite.Models.FeaturedViewModel
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/StorePageStyle.css")?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="@Url.Content("~/Content/MainPageStyle.css")?v=@DateTime.Now.Ticks" />
}

<div class="hp">

    <!-- 1. BANNER -->
    <section class="sectionbardivide"></section>
    <section class="hp-section ImageBannerContainer" id="ImageBannerID">
    </section>
    <section class="sectionbardivide"></section>
    <!-- 2. VỀ CHÚNG TÔI -->
    <section class="hp-section hp-about">
        <div class="hp-about__text">
            <span class="hp-eyebrow">Về chúng tôi</span>
            <h2>Chúng tôi bán gì?</h2>
            <p>
                Meisho Doshoes là nơi chuyên cung cấp giày sneaker nổi tiếng chính hãng, từ mẫu thể thao
                đến mẫu đi hằng ngày, cho cả nam giới và nữ giới.
            </p>
            <ul class="hp-checklist">
                <li>Cam kết 100% hàng chính hãng</li>
                <li>Giao hàng toàn quốc, kiểm tra hàng trước khi nhận</li>
                <li>Đổi size miễn phí trong 14 ngày</li>
            </ul>
            <a href="#" class="hp-btn">Xem sản phẩm</a>
        </div>
        <div class="hp-about__media">
            <img src="~/ImageAssets/MeishoesDoto.jpg" alt="Giày tại cửa hàng Meisho Doshoes" />
        </div>
    </section>
    <section class="sectionbardivide"></section>
    <!-- 3.1 DANH MỤC nhãn hàng -->
    <section class="hp-section">
        <div class="hp-heading">
            <span class="hp-eyebrow">Danh mục</span>
            <h2>Nhãn hàng giày theo sở thích bạn</h2>
        </div>
        <div class="hp-grid hp-grid--categories">
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="" alt="" />
                <span>Adidas</span>
            </a>
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="" alt="" />
                <span>Nike</span>
            </a>
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="" alt="" />
                <span>Puma</span>
            </a>
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="" alt="" />
                <span>New Balance</span>
            </a>
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="" alt="" />
                <span>Converse</span>
            </a>
        </div>
    </section>

    <!-- 3.2 DANH MỤC -->
    <section class="hp-section">
        <div class="hp-heading">
            <span class="hp-eyebrow">Danh mục</span>
            <h2>Mua sắm theo nhu cầu</h2>
        </div>
        <div class="hp-grid hp-grid--categories">
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="~/ImageAssets/Men/Nike1.jpg" alt="" />
                <span>Giày Nam</span>
            </a>
            <a href="@Url.Action("Index", "Store")" class="hp-category">
                <img src="~/ImageAssets/Women/Nike1.jpg" alt="" />
                <span>Giày Nữ</span>
            </a>
        </div>
    </section>
    <section class="sectionbardivide"></section>

    <!-- 4. SẢN PHẨM NỔI BẬT -->
    <section class="hp-section">
        <div class="hp-heading hp-heading--row">
            <div>
                <span class="hp-eyebrow">Nổi bật</span>
                <h2>Sản phẩm bán chạy</h2>
            </div>
            <a href="@Url.Action("Index", "Store")" class="hp-link">Xem tất cả →</a>
        </div>

        <div id="featured-container">
            @Html.Partial("_FeaturedProducts", Model)
        </div>
    </section>

    <section class="sectionbardivide"></section>

    <!-- Những người nổi tiếng đã nói gì về chúng tôi?-->
    <section class="hp-section hp-about">
        <div class="hp-about__media">
            <img src="~/ImageAssets/PopularIcons/LebronJames.jpg" alt="LebronJames" />
        </div>
        <div>
            <span class="hp-eyebrow">Người nổi tiếng đã nói gì về chúng tôi?</span>
            <h2>Lebron James</h2>
            <p>
                Meisho Doshoes là quả nơi chuyên cung cấp giày tuyệt vời, tôi không
                thể ăn cơm nếu thiếu giày của họ. (không nói thế)
            </p>
        </div>
    </section>
    <hr />
    <section class="hp-section hp-about">
        <div>
            <span class="hp-eyebrow">Người nổi tiếng đã nói gì về chúng tôi?</span>
            <h2>Alan Walker</h2>
            <p>
                Thật tuyệt vời, tôi đã mua sản phẩm tại Meisho Doshoes và
                nhờ có nó mà tôi đã có thể đi bộ nhiều hơn. (không nói thế)
            </p>
        </div>
        <div class="hp-about__media">
            <img src="~/ImageAssets/PopularIcons/AlanWalker.jpg" alt="Alan" />
        </div>
    </section>
    <hr />
    <section class="hp-section hp-about">
        <div class="hp-about__media">
            <img src="~/ImageAssets/PopularIcons/CristianoRonaldo.jpg" alt="Ronaldo" />
        </div>
        <div>
            <span class="hp-eyebrow">Người nổi tiếng đã nói gì về chúng tôi?</span>
            <h2>Cristiano Ronaldo</h2>
            <p>
                Thật đáng tiếc vì tôi đã không mua sản phẩm của Meisho Doshoes sớm hơn,
                sản phẩm thật tuyệt vời đáng lẽ tôi đã có thể ẫm world cup 2026. (không nói thế)
            </p>
        </div>
    </section>
    <hr />
    <section class="hp-section hp-about">
        <div>
            <span class="hp-eyebrow">Người nổi tiếng đã nói gì về chúng tôi?</span>
            <h2>Lionel Messi</h2>
            <p>
                Đôi giày của tôi đang mang rất tuyệt vời, nhờ vào Meisho Doshoes,
                tôi mới có thể chân chính trở thành GOAT của bóng đá thế giới. (Minh Tiến nói thế)
            </p>
        </div>
        <div class="hp-about__media">
            <img src="~/ImageAssets/PopularIcons/GOAT.jpg" alt="Messi" />
        </div>
    </section>
    <!-- 5. VÌ SAO CHỌN CHÚNG TÔI -->
    <section class="hp-band hp-band--soft">
        <div class="hp-section">
            <div class="hp-heading">
                <span class="hp-eyebrow">Cam kết</span>
                <h2>Vì sao chọn Meisho Doshoes?</h2>
            </div>
            <div class="hp-grid hp-grid--features">
                <div class="hp-feature">
                    <div class="hp-feature__icon">✔</div>
                    <h3>Chính hãng</h3>
                    <p>Nguồn hàng rõ ràng, có hóa đơn.</p>
                </div>
                <div class="hp-feature">
                    <div class="hp-feature__icon">🚚</div>
                    <h3>Giao nhanh</h3>
                    <p>Nhận hàng trong 2-4 ngày.</p>
                </div>
                <div class="hp-feature">
                    <div class="hp-feature__icon">↺</div>
                    <h3>Đổi trả dễ</h3>
                    <p>Đổi size trong vòng 14 ngày.</p>
                </div>
                <div class="hp-feature">
                    <div class="hp-feature__icon">☎</div>
                    <h3>Hỗ trợ 24/7</h3>
                    <p>Tư vấn chọn size, chọn mẫu.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 6. CALL TO ACTION -->
    <section class="hp-cta">
        <div class="hp-cta__inner">
            <div>
                <h2>Sẵn sàng tìm đôi giày của bạn?</h2>
                <p>Đăng ký thành viên để nhận ưu đãi cho đơn đầu tiên.</p>
            </div>
            <a href="@Url.Action("SignUp", "User")" class="hp-btn">Đăng ký ngay</a>
        </div>
    </section>

</div>

<script>
document.addEventListener("click", function (e) {
    var btn = e.target.closest(".hp-arrow");
    if (!btn) return;

    var container = document.getElementById("featured-container");
    container.style.opacity = 0.4;

    fetch('@Url.Action("FeaturedPage", "Home")?page=' + btn.dataset.page)
        .then(function (r) { return r.text(); })
        .then(function (html) {
            container.innerHTML = html;
            container.style.opacity = 1;
        });
});
</script>
<script>
    let currentimg = 1;
    const totalImages = 3; // Tổng số lượng ảnh của bạn

    // Mảng chứa đường dẫn ảnh chuẩn từ ASP.NET
    const bannerUrls = [
        '@Url.Content("~/ImageAssets/ImgBanner/1.jpg")',
        '@Url.Content("~/ImageAssets/ImgBanner/2.jpg")',
        '@Url.Content("~/ImageAssets/ImgBanner/3.jpg")'
    ];

    let imgContainer = document.getElementById('ImageBannerID');

    // Bước 1: Dùng innerHTML để khởi tạo và nhét TẤT CẢ ảnh vào khung ngay từ đầu
    function initBanner() {
        let content = '';
        for (let i = 0; i < bannerUrls.length; i++) {
            // Ảnh đầu tiên (index 0 ứng với ảnh 1) sẽ có sẵn class active
            let activeClass = (i === 0) ? 'active' : '';
            content += `<img src="${bannerUrls[i]}" class="ImageBanner ${activeClass}" alt="Sneaker Throwback Future">`;
        }
        imgContainer.innerHTML = content;
    }

    // Bước 2: Hàm chuyển ảnh mượt mà
    fnChangeBanner = function() {
        let images = imgContainer.getElementsByTagName('img');
        if (images.length === 0) return;

        // Xóa class active của ảnh hiện tại
        images[currentimg - 1].classList.remove('active');

        // Tăng biến đếm sang ảnh tiếp theo
        currentimg++;
        if (currentimg > totalImages) {
            currentimg = 1;
        }

        // Thêm class active cho ảnh mới để nó mờ dần hiện lên nhờ CSS transition
        images[currentimg - 1].classList.add('active');
    }

    // Chạy khởi tạo render ảnh lúc vừa tải trang
    initBanner();

    // Cứ mỗi 3 giây gọi hàm đổi ảnh một lần
    setInterval(fnChangeBanner, 3000);
</script>