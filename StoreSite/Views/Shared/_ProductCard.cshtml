@model StoreSite.Models.SanPham
@{
    bool hetHang = Model.SoLuongTon <= 0;
    bool isAdmin = (Session["IsAdmin"] as bool?) == true;
    var detailsUrl = Url.Action("Details", "Store", new { id = Model.Id });
}

<div class="card-product @(hetHang ? "is-soldout" : "")" data-href="@detailsUrl">

    @if (hetHang)
    {
        <div class="soldout-overlay" title="Sản phẩm đang tạm hết hàng">
            <span class="soldout-stamp">Đang tạm hết hàng</span>
        </div>
    }

    @if (Model.SanPhamMoi)
    {
        <span class="badge-new">Mới</span>
    }

    <div class="img-wrapper">
        <img src="@Url.Content("~" + Model.ImgURL)" class="img-product" alt="@Model.ItemName" />
    </div>

    <small class="brand">@Model.LoaiGiay - @Model.Gender - @Model.Sport</small>

    <h6 class="product-name">
        <a href="@detailsUrl">@Model.ItemName</a>
    </h6>

    <div class="my-2">
        <span class="price-sale">@Model.GiaTien.ToString("N0") đ</span>
        @if (Model.GiaTienGoc.HasValue && Model.GiaTienGoc.Value > Model.GiaTien)
        {
            <span class="price-old">@Model.GiaTienGoc.Value.ToString("N0") đ</span>
        }
    </div>

    <div class="rating">★ @Model.rating / 5.0</div>

    @if (hetHang)
    {
        <div class="stock-badge stock-badge--out">Kho còn: 0 đôi</div>
        if (isAdmin)
        {
            <a href="@Url.Action("Index", "AdminInventory", new { search = Model.ItemName })"
               class="btn-cart" style="background:#1e293b;">
                Nhập thêm hàng
            </a>
        }
        else
        {
            <span class="btn-cart btn-cart--disabled">Tạm hết hàng</span>
        }
    }
    else
    {
        <div class="stock-badge">Kho còn: @Model.SoLuongTon đôi</div>
        <a href="@detailsUrl" class="btn-cart">Thêm vào giỏ</a>
    }
</div>