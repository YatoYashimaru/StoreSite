@model StoreSite.Models.FeaturedViewModel

<div class="hp-featured-grid">
    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="hp-no-items">Không có sản phẩm nổi bật.</div>
    }
    else
    {
        <div class="hp-grid hp-grid--products">
            @foreach (var item in Model.Items)
            {
                <div class="hp-product">
                    @Html.Partial("_ProductCard", item)
                </div>
            }
        </div>
    }
</div>

<div class="hp-pagination" aria-label="Featured pagination">
    @if (Model.HasPrev)
    {
        <button type="button" class="hp-arrow" data-page="@(Model.Page - 1)">←</button>
    }
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <button type="button" class="hp-arrow @(i == Model.Page ? "active" : "")" data-page="@i">@i</button>
    }
    @if (Model.HasNext)
    {
        <button type="button" class="hp-arrow" data-page="@(Model.Page + 1)">→</button>
    }
</div>