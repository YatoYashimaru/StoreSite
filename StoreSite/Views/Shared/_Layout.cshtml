<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Meisho Doto Store Site</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/css/site.css" rel="stylesheet" />
    @RenderSection("scripts", required: false)
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav> hi </nav>
    <!--HEADER-->
    <header class="main-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">
                    <img src="#" alt="Logo" class="brand-logo" />
                    <span>MEISHO DOTO<span class="text-brand>STORE SITE</span></span>
                </a>
                <button class="navbar-toggler" type="button"
                        data-toggle="collapse" data-target="#mainNav"
                        data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon" id="mainNav"></span>
                </button>
                <div class="collapse navbar-collapse" id="main">
                    <ul class="navbar-nav mr-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Loại giày</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Liên hệ</a>
                        </li>
                    </ul>
                    <form class="form-inline search-form mr-3">
                        <input class="form-control" type="search" placeholder="Tìm Giày..." />
                    </form>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" href="#">Giỏ hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Đăng ký</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <!--NỘI DUNG WEBSITE-->
    <main>@RenderBody()</main>
    <!--FOOTER-->
    <footer class="main-footer bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5>MEISHO DOTO STORE SITE</h5>
                    <p class="small">GIÀY CHÍNH HÃNG</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h5>Về Thành Viên Nhóm</h5>
                    <ul class="list-unstyled small">
                        <li><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ&list=RDdQw4w9WgXcQ&start_radio=1" class="footer-link">GIỚI THIỆU</a></li>
                        <li><a href="https://www.facebook.com/share/g/19ZjhzT21U/?mibextid=wwXIfr" class="footer-link">TUYỂN DỤNG</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h5>Liên hệ nhanh</h5>
                    <ul class="list-unstyled small">
                        <li><a href="https://www.facebook.com/share/1DXwnLQpV9/?mibextid=wwXIfr" class="footer-link">FACEBOOK</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center small mb-0">&copy; @DateTime.Now.Year MEISHO DOTO STORE SITE</p>
            <p class="text-center small mb-0">UY TÍN - CHẤT LƯỢNG SỐ 1 VN</p>
            <p class="text-center small mb-0">(chưa được kiểm chứng)</p>
        </div>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("styles", required: false)
</body>
</html>
