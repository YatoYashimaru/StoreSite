<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Meisho Doshoes Store Site</title>

    @Styles.Render("~/Content/css")
    <link href="~/Content/LayoutStyle.css" rel="stylesheet" />
    

    @RenderSection("styles", required: false)
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <!--HEADER-->
    <header class="main-header">
        <nav class="site-nav">
            <a class="site-brand" href="@Url.Action("Index", "Home")">
                <img src="~/ImageAssets/MeishoLogo.jpg" alt="Logo" class="BrandLogo" />
                <span style="color:sandybrown"><span style="color:blueviolet">MEISHO DOSHOES</span> STORE SITE</span>
            </a>

            <ul class="site-menu">
                <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                <li><a href="@Url.Action("Index", "Store")">Shop</a></li>
                <li><a href="#">About</a></li>
                <li><a href="#">Liên hệ</a></li>
            </ul>

            <form class="search-form" action="@Url.Action("Index", "Home")" method="get">
                <input type="text" name="TimKiem" placeholder="Tìm Giày..." value="@ViewBag.CurrentSearch" />
            </form>

            <ul class="site-menu">
                <li><a href="#">Giỏ hàng</a></li>
                <li><a href="#">Đăng nhập</a></li>
                <li><a href="#">Đăng ký</a></li>
            </ul>
        </nav>
        <hr />
    </header>
    <!--NỘI DUNG WEBSITE-->
    <main>@RenderBody()</main>
    <!--FOOTER-->
    <footer class="main-footer bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            @Html.ActionLink("Application name", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Store", "About", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>