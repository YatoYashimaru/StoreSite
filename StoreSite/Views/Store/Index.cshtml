@model IEnumerable<StoreSite.Controllers.SanPham>

@{
    ViewBag.Title = "Cửa Hàng Giày - Meisho Doshoes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {<link href="~/Content/StorePageStyle.css" rel="stylesheet" />}

<!--GIAO DIỆN CHÍNH-->
<div class="container my-4">
    <div class="row">

        <!--BỘ LỌC (CỘT BÊN TRÁI)-->
        <div class="col-md-3">
            <div class="box-filter">
                <h5 class="font-weight-bold mb-3">Bộ Lọc Tìm Kiếm</h5>

                <!-- Form gửi dữ liệu lọc về Action Store -->
                @using (Html.BeginForm("Index", "Store", FormMethod.Get))
                {
                    <!--nhập tên giày-->
                    <div class="form-group mb-3">
                        <label><b>Tìm tên giày:</b></label>
                        <input type="text" name="TimKiem" class="form-control" placeholder="Nhập tên giày..." value="@ViewBag.TimKiem" />
                    </div>

                    <!--Chọn loại giày-->
                    <div class="form-group mb-3">
                        <label><b>Loại giày:</b></label>
                        <select name="Loai" class="form-control">
                            <option value="All" @(ViewBag.Loai == "All" ? "selected" : "")>All</option>
                            <option value="Nike" @(ViewBag.Loai == "Nike" ? "selected" : "")>Nike</option>
                            <option value="Adidas" @(ViewBag.Loai == "Adidas" ? "selected" : "")>Adidas</option>
                            <option value="Puma" @(ViewBag.Loai == "Puma" ? "selected" : "")>Puma</option>
                            <option value="Converse" @(ViewBag.Loai == "Converse" ? "selected" : "")>Converse</option>
                            <option value="Converse" @(ViewBag.Loai == "Vans" ? "selected" : "")>Vans</option>
                            <option value="Converse" @(ViewBag.Loai == "New Balance" ? "selected" : "")>New Balance</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label><b>Giới tính:</b></label>
                        <select name="Gender" class="form-control">
                            <option value="All" @(ViewBag.Gender == "All" ? "selected" : "")>All</option>
                            <option value="Nam" @(ViewBag.Gender == "Nam" ? "selected" : "")>Nam</option>
                            <option value="Nu" @(ViewBag.Gender == "Nữ" ? "selected" : "")>Nữ</option>

                        </select>
                    </div>
                    <!--Chọn sắp xếp theo giá tiền-->
                    <div class="form-group mb-3">
                        <label><b>Sắp xếp giá:</b></label>
                        <select name="sortOrder" class="form-control">
                            <option value="" @(string.IsNullOrEmpty(ViewBag.Sort) ? "selected" : "")>Mặc định</option>
                            <option value="Tang_Dan" @(ViewBag.Sort == "Tang_Dan" ? "selected" : "")>Giá từ thấp -> cao</option>
                            <option value="Giam_Dan" @(ViewBag.Sort == "Giam_Dan" ? "selected" : "")>Giá từ cao -> thấp</option>
                        </select>
                    </div>

                    <!--Nút bấm confirm-->
                    <button type="submit" class="btn btn-primary btn-block w-100">Lọc sản phẩm</button>
                    <a href="@Url.Action("Index", "Store")" class="btn btn-outline-secondary btn-block w-100 mt-2">Bỏ lọc</a>
                }
            </div>
        </div>

        <!--DANH SÁCH SẢN PHẨM (CỘT BÊN PHẢI)-->
        <div class="col-md-9">
            <!--Tiêu đề & Số lượng-->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="font-weight-bold">Danh Sách Giày</h4>
                <span>Tìm thấy <b>@Model.Count()</b> sản phẩm</span>
            </div>

            <!--Vòng lặp hiển thị từng sản phẩm-->
            <div class="row">
                @if (!Model.Any())
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-danger">Không tìm thấy sản phẩm nào phù hợp!</p>
                    </div>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <div class="col-md-4 col-sm-6">
                            @Html.Partial("_ProductCard", item)
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>
