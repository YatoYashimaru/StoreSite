@model StoreSite.Models.ProductFormViewModel
@{
    bool them = Model.Id == 0;
    ViewBag.Title = them ? "Thêm sản phẩm" : "Sửa sản phẩm";
    string action = them ? "ProductCreate" : "ProductEdit";
}

<div class="ad-head">
    <div>
        <h1 class="ad-title">@(them ? "Thêm sản phẩm" : "Sửa sản phẩm")</h1>
        @if (!them)
        {
            <p class="ad-sub">Mã sản phẩm #@Model.Id</p>
        }
    </div>
    <a class="ad-btn ad-btn--ghost" href="@Url.Action("Products", "Admin")">← Về danh sách</a>
</div>

@using (Html.BeginForm(action, "Admin", FormMethod.Post, new { @class = "ad-card ad-form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "ad-alert ad-alert--err" })

    <div class="ad-grid">

        <div class="ad-field ad-field--full">
            @Html.LabelFor(m => m.ItemName)
            @Html.TextBoxFor(m => m.ItemName, new { @class = "ad-input", maxlength = 200, autofocus = "autofocus" })
            @Html.ValidationMessageFor(m => m.ItemName, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field">
            @Html.LabelFor(m => m.LoaiGiay)
            @Html.TextBoxFor(m => m.LoaiGiay, new { @class = "ad-input", maxlength = 80, list = "dl-brands", autocomplete = "off" })
            <datalist id="dl-brands">
                @foreach (var b in (System.Collections.Generic.List<string>)ViewBag.Brands)
                {
                    <option value="@b"></option>
                }
            </datalist>
            @Html.ValidationMessageFor(m => m.LoaiGiay, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field">
            @Html.LabelFor(m => m.Sport)
            @Html.TextBoxFor(m => m.Sport, new { @class = "ad-input", maxlength = 80, list = "dl-sports", autocomplete = "off" })
            <datalist id="dl-sports">
                @foreach (var s in (System.Collections.Generic.List<string>)ViewBag.Sports)
                {
                    <option value="@s"></option>
                }
            </datalist>
            @Html.ValidationMessageFor(m => m.Sport, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field">
            @Html.LabelFor(m => m.Gender)
            @Html.DropDownListFor(m => m.Gender, new[]
            {
                new SelectListItem { Text = "Nam", Value = "Nam" },
                new SelectListItem { Text = "Nữ", Value = "Nu" }
            }, new { @class = "ad-input" })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field">
            @Html.LabelFor(m => m.GiaTien)
            @Html.TextBoxFor(m => m.GiaTien, new { @class = "ad-input", type = "number", min = 1000, step = 1000, inputmode = "numeric", placeholder = "từ 1000" })
            @Html.ValidationMessageFor(m => m.GiaTien, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field">
            @Html.LabelFor(m => m.GiaTienGoc)
            @Html.TextBoxFor(m => m.GiaTienGoc, new { @class = "ad-input", type = "number", min = 1000, step = 1000, inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.GiaTienGoc, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field ad-field--full">
            <label for="ad-files">Ảnh sản phẩm</label>

            @if (Model.ExistingImages.Count > 0)
            {
                <p class="ad-hint ad-hint--top">Ảnh hiện có trong <code>@Model.ImageFolderText</code>. Đánh dấu “Xóa” để bỏ ảnh nào đó.</p>
                <div class="ad-imgs">
                    @foreach (var img in Model.ExistingImages)
                    {
                        <label class="ad-imgs__item">
                            <img src="@(img.Url + "?v=" + DateTime.Now.Ticks)" alt="" loading="lazy" />
                            <span class="ad-imgs__name">@img.FileName</span>
                            <span class="ad-imgs__del"><input type="checkbox" name="removeImages" value="@img.FileName" /> Xóa</span>
                        </label>
                    }
                </div>
            }
            else if (!them && !string.IsNullOrEmpty(Model.ImgURL))
            {
                <p class="ad-hint ad-hint--top">
                    Ảnh hiện tại (<code>@Model.ImgURL</code>) nằm ngoài cấu trúc thư mục hãng. Chọn ảnh mới bên dưới để tạo thư mục
                    riêng cho sản phẩm và thay thế; không chọn thì giữ nguyên.
                </p>
            }

            <input type="file" id="ad-files" name="images" class="ad-file" multiple
                   accept="image/jpeg,image/png,image/webp,image/avif,image/gif" />
            <div class="ad-imgs" id="ad-newimgs" aria-live="polite"></div>
            <div class="ad-img-count" id="ad-img-count"></div>

            <p class="ad-hint">
                Ảnh được lưu vào <code id="ad-folder">ImageAssets/Men|Women/Hãng/Tên sản phẩm/</code> và <b>tự đặt tên 1, 2, 3 … n</b>
                theo thứ tự hiển thị ở trên (ảnh số 1 là ảnh đại diện, trang chi tiết hiện cả bộ ảnh theo thứ tự này).
                Mẹo: đặt tên tệp 1, 2, 3 … trên máy rồi chọn một lượt, hệ thống tự xếp đúng thứ tự; bấm ◀ ▶ để đổi chỗ, ✕ để bỏ.
                Tối đa @StoreSite.Models.ProductImageStore.MaxFiles ảnh, mỗi ảnh tối đa @(StoreSite.Models.ProductImageStore.MaxFileBytes / 1024 / 1024) MB (jpg, png, webp, avif, gif).
            </p>
            @Html.ValidationMessage("images", "", new { @class = "ad-error" })
        </div>

        <div class="ad-field ad-field--full">
            @Html.LabelFor(m => m.DescriptionTxt)
            @Html.TextAreaFor(m => m.DescriptionTxt, 6, 60, new { @class = "ad-input ad-textarea" })
            @Html.ValidationMessageFor(m => m.DescriptionTxt, "", new { @class = "ad-error" })
        </div>

        <div class="ad-field ad-field--full">
            <label class="ad-check">
                @Html.CheckBoxFor(m => m.SanPhamMoi)
                <span>@Html.DisplayNameFor(m => m.SanPhamMoi)</span>
            </label>
        </div>
    </div>

    <div class="ad-form__actions">
        <button type="submit" class="ad-btn ad-btn--primary">@(them ? "Thêm sản phẩm" : "Lưu thay đổi")</button>
        <a class="ad-btn ad-btn--ghost" href="@Url.Action("Products", "Admin")">Hủy</a>
    </div>
}

@section Scripts {
    <script>
        (function () {
            "use strict";

            var MAX = @(StoreSite.Models.ProductImageStore.MaxFiles);
            var MAX_BYTES = @(StoreSite.Models.ProductImageStore.MaxFileBytes);
            var OK_EXT = /\.(jpe?g|png|webp|avif|gif)$/i;

            var input = document.getElementById('ad-files');
            var grid = document.getElementById('ad-newimgs');
            var count = document.getElementById('ad-img-count');
            var folderEl = document.getElementById('ad-folder');
            if (!input || !grid) return;

            var files = [];                       // các ảnh đã chọn, theo đúng thứ tự sẽ được đặt tên
            var kept = document.querySelectorAll('input[name="removeImages"]');   // ảnh cũ trong form sửa

            function keptCount() {
                var n = 0;
                for (var i = 0; i < kept.length; i++) if (!kept[i].checked) n++;
                return n;
            }

            function sync() {                     // đẩy danh sách đã sắp xếp lại vào ô chọn tệp để gửi đi
                try {
                    var dt = new DataTransfer();
                    files.forEach(function (f) { dt.items.add(f); });
                    input.files = dt.files;
                } catch (e) { /* trình duyệt cũ: gửi theo lựa chọn gốc */ }
            }

            function render() {
                grid.innerHTML = '';
                var start = keptCount() + 1;
                files.forEach(function (f, i) {
                    var item = document.createElement('div');
                    item.className = 'ad-imgs__item';

                    var img = document.createElement('img');
                    img.alt = '';
                    img.src = URL.createObjectURL(f);
                    img.onload = function () { URL.revokeObjectURL(img.src); };
                    item.appendChild(img);

                    var name = document.createElement('span');
                    name.className = 'ad-imgs__name';
                    name.textContent = '→ ' + (start + i);
                    name.title = f.name;
                    item.appendChild(name);

                    var tools = document.createElement('span');
                    tools.className = 'ad-imgs__tools';
                    [['◀', -1, 'Đưa lên trước'], ['▶', 1, 'Đưa ra sau'], ['✕', 0, 'Bỏ ảnh này']].forEach(function (b) {
                        var btn = document.createElement('button');
                        btn.type = 'button';
                        btn.textContent = b[0];
                        btn.title = b[2];
                        btn.setAttribute('aria-label', b[2]);
                        btn.onclick = function () {
                            if (b[1] === 0) files.splice(i, 1);
                            else {
                                var j = i + b[1];
                                if (j < 0 || j >= files.length) return;
                                var t = files[i]; files[i] = files[j]; files[j] = t;
                            }
                            sync(); render();
                        };
                        tools.appendChild(btn);
                    });
                    item.appendChild(tools);
                    grid.appendChild(item);
                });

                var total = keptCount() + files.length;
                count.textContent = files.length
                    ? 'Đã chọn ' + files.length + ' ảnh mới, tổng cộng ' + total + '/' + MAX + ' ảnh.'
                    : '';
                count.className = 'ad-img-count' + (total > MAX ? ' is-over' : '');
            }

            input.addEventListener('change', function () {
                var picked = Array.prototype.slice.call(input.files);
                // xếp theo tên tệp có tính số (1, 2, 10 chứ không phải 1, 10, 2)
                picked.sort(function (a, b) { return a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }); });

                var problems = [];
                picked.forEach(function (f) {
                    if (!OK_EXT.test(f.name)) { problems.push('“' + f.name + '” không phải ảnh được hỗ trợ.'); return; }
                    if (f.size > MAX_BYTES) { problems.push('“' + f.name + '” lớn hơn ' + (MAX_BYTES / 1048576) + ' MB.'); return; }
                    var dup = files.some(function (x) { return x.name === f.name && x.size === f.size && x.lastModified === f.lastModified; });
                    if (!dup) files.push(f);
                });
                if (keptCount() + files.length > MAX) {
                    problems.push('Tối đa ' + MAX + ' ảnh cho mỗi sản phẩm.');
                    files = files.slice(0, Math.max(0, MAX - keptCount()));
                }
                if (problems.length) alert(problems.join('\n'));

                sync(); render();
            });

            for (var k = 0; k < kept.length; k++) kept[k].addEventListener('change', render);

            // Hiện thư mục sẽ lưu ảnh theo hãng / giới tính / tên sản phẩm đang nhập (cùng quy tắc đặt tên với server)
            var brand = document.getElementById('LoaiGiay');
            var gender = document.getElementById('Gender');
            var pname = document.getElementById('ItemName');
            var fixedFolder = @Html.Raw(Json.Encode(Model.ImageFolderText ?? ""));

            function folderName(s) {
                s = (s || '').replace(/[\\\/:*?"<>|#%&+]/g, ' ').replace(/[\x00-\x1f]/g, ' ').replace(/\s+/g, ' ').replace(/^[ .]+|[ .]+$/g, '');
                return (s || 'San pham').substring(0, 100);
            }
            function showFolder() {
                if (!folderEl) return;
                if (fixedFolder) { folderEl.textContent = fixedFolder + '/'; return; }
                var g = gender && gender.value === 'Nu' ? 'Women' : 'Men';
                var b = brand && brand.value.trim() ? brand.value.trim() : 'Hãng';
                folderEl.textContent = 'ImageAssets/' + g + '/' + b + '/' + folderName(pname && pname.value) + '/';
            }
            [brand, gender, pname].forEach(function (el) {
                if (el) { el.addEventListener('input', showFolder); el.addEventListener('change', showFolder); }
            });
            showFolder();
            render();
        })();
    </script>
}
